    # This file was generated using idf.py save-defconfig. It can be edited manually.
    # Espressif IoT Development Framework (ESP-IDF) 6.0.0 Project Minimal Configuration
    #
    # default:
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_SPIRAM=y

# LVGL font / buffer
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=512000
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_COMPRESSED=y

# PPA hardware-accelerated rotation (ESP32-P4 has PPA)
CONFIG_LVGL_PORT_ENABLE_PPA=y

# Partition table — custom for 16 MB flash
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# USB Host (ESP32-P4 HS host requires experimental features)
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=3072
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y

# PSRAM speed up and reserve internal heap for USB/WiFi
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# DW-GDMA channel/group structs must stay in internal SRAM (avoid PSRAM cache coherency crash in ISR)
CONFIG_DW_GDMA_ISR_IRAM_SAFE=y
CONFIG_DW_GDMA_OBJ_DRAM_SAFE=y

